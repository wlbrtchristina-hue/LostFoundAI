# ===== 使用说明 =====
# 复制本文件为 .env，并填入真实配置：
#   cp .env.example .env
# .env 已被 git 忽略，不会提交到仓库。

# Supabase 项目 URL（控制台 → Settings → API → Project URL）
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon public key（控制台 → Settings → API → anon public）
SUPABASE_ANON_KEY=your-anon-key

# 后端 FastAPI 地址：
#   Android 模拟器 → http://10.0.2.2:8000
#   Windows 桌面 / Chrome → http://localhost:8000
#   真机调试 → http://<后端电脑局域网IP>:8000
API_BASE_URL=http://10.0.2.2:8000
