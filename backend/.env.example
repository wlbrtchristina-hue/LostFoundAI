# ===== 使用说明 =====
# 复制本文件为 .env，填入真实值。.env 已被 .gitignore 忽略。

# Supabase 项目 URL（与前端 .env 一致）
SUPABASE_URL=https://your-project.supabase.co

# service_role 密钥（控制台 → Settings → API → service_role secret）
# 注意：这是最高权限密钥，只可放在服务端，绝不能进客户端代码
SERVICE_ROLE_KEY=eyJ...

# DeepSeek API Key（用于 /vision 图片识别，控制台 https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-xxxxxxxx

# 视觉识别模型（DeepSeek 官方视觉模型）
VISION_MODEL=deepseek-v4-flash-vision-exp
